table fact_calendar
	lineageTag: 986d96cc-f3df-40cf-b148-a6616b548374
	sourceLineageTag: [dbo].[fact_calendar]

	/// Proporcion de noches NO disponibles en los 30 dias siguientes a la captura. Limite superior de la ocupacion real: 'no disponible' mezcla reservas, bloqueos y anuncios cerrados.
	measure 'Ocupacion aprox 30d' = DIVIDE(CALCULATE(COUNTROWS(fact_calendar), fact_calendar[available] = FALSE(), fact_calendar[dias_antelacion] >= 0, fact_calendar[dias_antelacion] <= 29), CALCULATE(COUNTROWS(fact_calendar), fact_calendar[dias_antelacion] >= 0, fact_calendar[dias_antelacion] <= 29))
		formatString: 0.0%
		displayFolder: Revenue
		lineageTag: b1fd4e22-a16b-493f-be03-4681dc88b192

	/// ADR mediano por ocupacion aproximada a 30 dias. Indicador comparativo, no ingreso real.
	measure 'RevPAR aprox 30d' = [ADR mediano] * [Ocupacion aprox 30d]
		formatString: #,##0.00
		displayFolder: Revenue
		lineageTag: 33793ad5-c09a-4796-9c3d-9327bc144d7b

