table fact_listing_snapshot
	lineageTag: 6749dc35-41b4-44a5-80cd-0633fb07c99a
	sourceLineageTag: [dbo].[fact_listing_snapshot]

	/// Anuncios distintos en el contexto (snapshot, zona...).
	measure Anuncios = DISTINCTCOUNT(fact_listing_snapshot[listing_id])
		formatString: #,##0
		displayFolder: Revenue
		lineageTag: 5e9dd25a-2cea-49da-a47c-1bd915b8b6d0

	/// Precio publicado mediano (en euros) de anuncios de corta estancia, con precio y sin el valor centinela 9999. Es precio publicado, no cobrado.
	measure 'ADR mediano' = MEDIANX(FILTER(fact_listing_snapshot, fact_listing_snapshot[price_missing] = FALSE() && fact_listing_snapshot[price_outlier] = FALSE() && fact_listing_snapshot[is_long_stay] = FALSE()), fact_listing_snapshot[price_num])
		formatString: #,##0.00
		displayFolder: Revenue
		lineageTag: c865222c-311f-4500-99fc-0cad80743e87

	/// Texto de aviso cuando la seleccion incluye snapshots sin precio en origen.
	measure 'Nota precio' = IF(CALCULATE(COUNTROWS(dim_snapshot), dim_snapshot[tiene_precio] = FALSE()) > 0, "Hay snapshots sin precio publicado (dic 2025 a feb 2026): el ADR no se calcula", BLANK())
		displayFolder: Avisos
		lineageTag: 24c7e02c-fcb8-499e-a66f-1863e8946c04

	/// Texto de aviso cuando la seleccion incluye snapshots incompletos.
	measure 'Nota cobertura' = IF(CALCULATE(COUNTROWS(dim_snapshot), dim_snapshot[es_completo] = FALSE()) > 0, "Hay snapshots parciales (menos del 85 % de los anuncios habituales): comparar con cautela", BLANK())
		displayFolder: Avisos
		lineageTag: 21996067-987e-46e0-829f-a05dc8aa4598

